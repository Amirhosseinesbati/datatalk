# Local synthetic demo only. Copy to .env and replace the placeholder secrets.
DATATALK_DB_PASSWORD=replacewithrandomalphanumericdbpassword
DATATALK_APP_PASSWORD=replacewithrandomalphanumericapppassword
DATATALK_READER_PASSWORD=replacewithrandomalphanumericreaderpassword
DATATALK_SECRET_KEY=replacewithatleast32randomcharactersforcookies
DATATALK_DEMO_PASSWORD=DemoPass123!
DATATALK_MODE=demo
DATATALK_MODEL_ID=
OPENAI_API_KEY=
DATATALK_COOKIE_SECURE=false
# Host ports can be changed if 8000 or 8080 are occupied.
DATATALK_API_PORT=8000
DATATALK_WEB_PORT=8080
# For a separate development web origin only:
# DATATALK_ALLOWED_ORIGINS=http://localhost:5175

# Set to true behind HTTPS for an installed customer instance.
# Keep model credentials on the API service; never put them in VITE_ variables.
