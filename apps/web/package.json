{
  "name": "datatalk-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-openapi.mjs && tsc -b && vite build",
    "typecheck": "node scripts/check-openapi.mjs && tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "licenses": "node scripts/license-report.mjs",
    "api:check": "node scripts/check-openapi.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.2",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.13",
    "@vitejs/plugin-react": "4.7.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
}
